function parse(){lines=source.split(/(?<=\n)/);rows=[];let weather="Clima",time="Horário";for(let i=0;i<lines.length;i++){let line=lines[i],trim=line.trim();if(trim.startsWith("//")){let w=trim.match(/EXTRASUNNY|SUNNY|CLOUDY|RAINY|FOGGY|EXTRASUNNY_LA|SUNNY_LA|CLOUDY_LA|RAINY_LA|FOGGY_LA/i);if(w)weather=w[0];let tm=trim.match(/^\/\/\s*(Midnight|\d{1,2}\s?(?:AM|PM)|Sunrise|Sunset|Noon|Midday|Evening|Night|Dawn|Dusk)/i);if(tm)time=tm[1];continue;}let matches=[...line.matchAll(/(?<!\S)[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?!\S)/g)];if(matches.length>=45){rows.push({lineIndex:i,weather,time,matches,values:matches.map(m=>m[0]),key:weather+" · "+time});}}}
function esc(s){return String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));}
function rgb(vals){return "#"+vals.slice(0,3).map(v=>Math.max(0,Math.min(255,Math.round(Number(v)||0))).toString(16).padStart(2,"0")).join("");}
function current(){return rows[Math.max(0,Math.min(selectedRow,rows.length-1))]}
function setVal(idx,val){let r=current();if(!r||idx>=r.values.length)return;r.values[idx]=String(val);dirty.add(r.lineIndex+":"+idx);let m=r.matches[idx];let line=lines[r.lineIndex];lines[r.lineIndex]=line.slice(0,m.index)+String(val)+line.slice(m.index+m[0].length);parseRowsAfterEdit(r);renderPreview();renderSummary();document.getElementById("footer").textContent="● Alterações locais feitas. Exporte para salvar o arquivo.";}
function parseRowsAfterEdit(r){let newLine=lines[r.lineIndex];let ms=[...newLine.matchAll(/(?<!\S)[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?!\S)/g)];r.matches=ms;r.values=ms.map(m=>m[0]);}
function renderNav(){document.getElementById("nav").innerHTML=navItems.map(([id,ico,title,sub])=>`<button class="nav ${activeNav===id?"active":""}" data-nav="${id}"><span class="ico">${ico}</span><b>${title}</b><small>${sub}</small></button>`).join("");document.querySelectorAll("[data-nav]").forEach(b=>b.onclick=()=>{activeNav=b.dataset.nav;renderNav();renderEditor();});}
function renderSelectors(){let w=[...new Set(rows.map(r=>r.weather))],t=[...new Set(rows.filter(r=>r.weather===current()?.weather).map(r=>r.time))];let ws=document.getElementById("weatherSelect"),ts=document.getElementById("timeSelect");ws.innerHTML=w.map(x=>`<option ${x===current()?.weather?"selected":""}>${esc(x)}</option>`).join("");ts.innerHTML=t.map(x=>`<option ${x===current()?.time?"selected":""}>${esc(x)}</option>`).join("");ws.onchange=()=>{let ix=rows.findIndex(r=>r.weather===ws.value);selectedRow=Math.max(0,ix);renderSelectors();renderEditor();};ts.onchange=()=>{let ix=rows.findIndex(r=>r.weather===ws.value&&r.time===ts.value);if(ix>=0)selectedRow=ix;renderEditor();};}
function visibleGroups(){return groups.filter(g=>{if(activeNav==="sky")return [9,12].includes(g.start);if(activeNav==="sun")return [15,18].includes(g.start);if(activeNav==="moon")return false;if(activeNav==="cloud")return [29,32].includes(g.start);if(activeNav==="water")return g.start>=35&&g.start<=43;if(activeNav==="light")return [0,3,6].includes(g.start);if(activeNav==="numeric")return false;return true;});}
function renderEditor(){if(!rows.length)return;let r=current();document.getElementById("sectionTitle").textContent=(navItems.find(n=>n[0]===activeNav)||navItems[0]).slice(1,3).join(" ");document.getElementById("sectionDesc").textContent=`Editando ${r.weather} · ${r.time}. Cada controle altera somente este registro do timecyc.dat.`;let gs=visibleGroups();document.getElementById("colorCount").textContent=gs.length+" grupos de cor";document.getElementById("colorCards").innerHTML=gs.map(g=>{let v=r.values.slice(g.start,g.start+g.n);if(v.length<3)return"";let color=rgb(v);return `<div class="colorcard"><div class="colorhead"><span class="swatch" style="background:${color}"></span><div>${g.name}<div class="muted" style="font-size:11px;font-weight:400">${g.desc}</div></div></div><div class="rgbrow"><b>R</b><input type="number" min="0" max="255" value="${esc(v[0])}" data-idx="${g.start}" title="Vermelho (0–255)"></div><div class="rgbrow"><b>G</b><input type="number" min="0" max="255" value="${esc(v[1])}" data-idx="${g.start+1}" title="Verde (0–255)"></div><div class="rgbrow"><b>B</b><input type="number" min="0" max="255" value="${esc(v[2])}" data-idx="${g.start+2}" title="Azul (0–255)"></div>${g.n===4?`<div class="rgbrow"><b>A</b><input type="number" min="0" max="255" value="${esc(v[3])}" data-idx="${g.start+3}" title="Alpha / opacidade"></div>`:""}<div class="colorfoot"><input type="color" value="${color}" data-colorstart="${g.start}" aria-label="Seletor visual de cor"><span class="muted" style="font-size:11px">Escolha visualmente ou informe RGB</span></div></div>`;}).join("");document.querySelectorAll("#colorCards input[type=number]").forEach(el=>el.onchange=()=>{let n=Number(el.value);if(!Number.isFinite(n))return;setVal(+el.dataset.idx,Math.max(0,Math.min(255,Math.round(n))));renderEditor();});document.querySelectorAll("[data-colorstart]").forEach(el=>el.oninput=()=>{let hex=el.value.slice(1);[0,2,4].forEach((p,i)=>setVal(+el.dataset.colorstart+i,parseInt(hex.slice(p,p+2),16)));renderEditor();});let excluded=new Set(groups.flatMap(g=>Array.from({length:g.n},(_,i)=>g.start+i)));let indices=activeNav==="numeric"?r.values.map((_,i)=>i).filter(i=>!excluded.has(i)):r.values.map((_,i)=>i).filter(i=>!excluded.has(i));document.getElementById("numberFields").innerHTML=indices.map(i=>`<div class="field"><label>${scalarNames[i]||"Parâmetro técnico "+(i+1)} <span class="muted">· índice ${i+1}</span></label><input type="text" inputmode="decimal" value="${esc(r.values[i])}" data-numidx="${i}" title="Valor original no timecyc.dat"><div class="desc">Valor original preservado; altere apenas se souber o efeito esperado.</div></div>`).join("");document.querySelectorAll("[data-numidx]").forEach(el=>el.onchange=()=>{if(el.value.trim()!==""&&Number.isFinite(Number(el.value)))setVal(+el.dataset.numidx,el.value.trim());else el.value=current().values[+el.dataset.numidx];});renderPreview();renderSummary();}
function renderPreview(){let r=current();if(!r)return;let top=rgb(r.values.slice(9,12)),bottom=rgb(r.values.slice(12,15)),sun=rgb(r.values.slice(15,18));let p=document.querySelector(".preview");p.style.background=`linear-gradient(${top} 0%,${bottom} 60%,#172b3b 100%)`;document.getElementById("previewSun").style.background=sun;document.getElementById("previewSun").style.boxShadow=`0 0 28px 10px ${sun}88`;document.getElementById("city").innerHTML=Array.from({length:17},(_,i)=>`<i style="height:${22+(i*17%68)}%;opacity:${.65+(i%3)*.1}"></i>`).join("");}
function renderSummary(){let r=current();document.getElementById("status").textContent=dirty.size?`${dirty.size} valor(es) editado(s). Exporte para aplicar ao arquivo.`:"Nenhuma alteração feita nesta sessão.";let shown=groups.map(g=>({g,v:r.values.slice(g.start,g.start+3)})).filter(x=>x.v.length===3);document.getElementById("summary").innerHTML=shown.slice(0,8).map(x=>`<div class="summaryrow"><span class="dot" style="background:${rgb(x.v)}"></span><span style="flex:1">${x.g.short}</span><span class="muted">${x.v.join(" · ")}</span></div>`).join("");document.getElementById("fileInfo").innerHTML=`Arquivo atual: <b>${esc(window.filename||"timecyc.dat")}</b><br>Registros detectados: ${rows.length}<br>Alterações: ${dirty.size}<br>Codificação: Latin-1 / bytes preservados quando possível`;}
function rebuild(){source=lines.join("");}
function exportFile(){rebuild();let blob=new Blob([source],{type:"application/octet-stream"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=(window.filename||"timecyc.dat").replace(/\.(dat|txt)$/i,"")+"_editado.dat";a.click();URL.revokeObjectURL(url);document.getElementById("footer").textContent="✓ Exportação iniciada. Confira o arquivo baixado antes de substituir o original.";}
function importFile(file){if(!file)return;let reader=new FileReader();reader.onerror=()=>{alert("Não foi possível ler esse arquivo. Tente selecionar o timecyc.dat novamente.");};reader.onload=()=>{source=String(reader.result||"");window.filename=file.name;dirty.clear();selectedRow=0;parse();if(!rows.length){alert("Não encontrei registros timecyc reconhecíveis (linhas com valores numéricos). O arquivo foi carregado, mas não há registros para editar.");}renderSelectors();renderNav();renderEditor();document.getElementById("footer").textContent=`✓ ${file.name} importado. ${rows.length} registros detectados.`;};reader.readAsText(file,"ISO-8859-1");}
document.getElementById("importBtn").onclick=document.getElementById("importBtn2").onclick=()=>document.getElementById("fileInput").click();document.getElementById("fileInput").onchange=e=>{const f=e.target.files&&e.target.files[0];if(f)importFile(f);e.target.value="";};document.getElementById("exportBtn").onclick=document.getElementById("exportBtn2").onclick=exportFile;document.getElementById("resetBtn").onclick=()=>{if(!confirm("Descartar todas as alterações e restaurar o arquivo importado?"))return;source=ORIGINAL;window.filename="timecyc.dat";dirty.clear();selectedRow=0;parse();renderSelectors();renderEditor();document.getElementById("footer").textContent="Alterações descartadas; arquivo de exemplo restaurado.";};
window.filename="timecyc.dat";parse();renderNav();renderSelectors();renderEditor();
</script></body></html>
